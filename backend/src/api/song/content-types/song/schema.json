{
  "kind": "collectionType",
  "collectionName": "songs",
  "info": {
    "singularName": "song",
    "pluralName": "songs",
    "displayName": "Song",
    "description": "Songs with audio files and synchronized lyrics"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "titleChinese": {
      "type": "string"
    },
    "artist": {
      "type": "string",
      "default": "Kungpao"
    },
    "audioFile": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["audios"]
    },
    "lyricsOriginal": {
      "type": "text",
      "description": "Original Chinese lyrics"
    },
    "lyricsCzech": {
      "type": "text",
      "description": "Czech translation"
    },
    "lyricsTimestamps": {
      "type": "json",
      "description": "Array of {time: number, line: number} for synchronization"
    },
    "duration": {
      "type": "integer",
      "description": "Duration in seconds"
    },
    "releaseYear": {
      "type": "integer"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    }
  }
}
