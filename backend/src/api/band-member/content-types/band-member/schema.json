{
  "kind": "collectionType",
  "collectionName": "band_members",
  "info": {
    "singularName": "band-member",
    "pluralName": "band-members",
    "displayName": "Band Member",
    "description": "Band member profiles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "nameChinese": {
      "type": "string"
    },
    "instrument": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "richtext"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "joinedYear": {
      "type": "integer"
    },
    "leftYear": {
      "type": "integer"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "description": "Display order"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    }
  }
}
